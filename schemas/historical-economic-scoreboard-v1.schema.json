{
  "$id": "https://schemas.aladdin-mev.dev/historical-economic-scoreboard-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cohort": {
      "$ref": "historical-cohort-key-v1.schema.json"
    },
    "cohort_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "confidence_guarantee": {
      "const": false
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "global_completeness_guarantee": {
      "const": false
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "absolute_prediction_error_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "aggregate_historical_return_bps_floor": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "attempt_capital_at_risk_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "attempt_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "cost_upper_bound_respect_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "cost_upper_bounds_respected_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "execution_success_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "execution_success_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "floor_preservation_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "floor_preserved_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "guarded_mean_historical_surplus_floor": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "historical_conservative_surplus_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "mean_absolute_prediction_error_bps_of_capital_ceiling": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "mean_absolute_prediction_error_ceiling": {
          "maxLength": 156,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "mean_historical_conservative_surplus_floor": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "native_cost_overrun_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "native_cost_overrun_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "outcome_evidence_complete_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "outcome_evidence_complete_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "positive_historical_surplus_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "positive_historical_surplus_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "predicted_conservative_net_profit_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "prediction_error_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "reverted_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "scoreable_capital_at_risk_sum": {
          "maxLength": 156,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "scoreable_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "scoreable_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "settled_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "settlement_evidence_incomplete_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "settlement_missing_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "settlement_observed_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "settlement_observed_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "simulation_exact_match_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "simulation_exact_match_rate_bps": {
          "maxLength": 5,
          "pattern": "^(?:0|[1-9][0-9]{0,3}|10000)$",
          "type": "string"
        },
        "unique_inclusion_block_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        },
        "unscoreable_count": {
          "maxLength": 3,
          "pattern": "^(?:0|[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
          "type": "string"
        }
      },
      "required": [
        "absolute_prediction_error_sum",
        "aggregate_historical_return_bps_floor",
        "attempt_capital_at_risk_sum",
        "attempt_count",
        "cost_upper_bound_respect_rate_bps",
        "cost_upper_bounds_respected_count",
        "execution_success_count",
        "execution_success_rate_bps",
        "floor_preservation_rate_bps",
        "floor_preserved_count",
        "guarded_mean_historical_surplus_floor",
        "historical_conservative_surplus_sum",
        "mean_absolute_prediction_error_bps_of_capital_ceiling",
        "mean_absolute_prediction_error_ceiling",
        "mean_historical_conservative_surplus_floor",
        "native_cost_overrun_count",
        "native_cost_overrun_rate_bps",
        "positive_historical_surplus_count",
        "positive_historical_surplus_rate_bps",
        "predicted_conservative_net_profit_sum",
        "prediction_error_sum",
        "scoreable_capital_at_risk_sum",
        "scoreable_count",
        "scoreable_rate_bps",
        "settlement_observed_count",
        "settlement_observed_rate_bps",
        "simulation_exact_match_count",
        "simulation_exact_match_rate_bps",
        "unique_inclusion_block_count",
        "unscoreable_count",
        "settled_count",
        "reverted_count",
        "settlement_missing_count",
        "settlement_evidence_incomplete_count",
        "outcome_evidence_complete_count",
        "outcome_evidence_complete_rate_bps"
      ],
      "type": "object"
    },
    "production_promotion_authority": {
      "const": false
    },
    "realized_profit_claimed": {
      "const": false
    },
    "record_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "aladdin-mev-historical-economic-scoreboard/v1"
    },
    "scoreboard_id": {
      "pattern": "^historical-scoreboard-[0-9a-f]{64}$",
      "type": "string"
    },
    "scoreboard_scope": {
      "const": "exact-cohort-inclusion-conditioned-history"
    },
    "source_completeness_scope": {
      "const": "exact-declared-source-window-reference-set-only"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "unscoreable_records_retained": {
      "const": true
    }
  },
  "required": [
    "schema",
    "scoreboard_id",
    "corpus_sha256",
    "cohort",
    "cohort_sha256",
    "record_sha256",
    "metrics",
    "created_at_unix_ms",
    "scoreboard_scope",
    "unscoreable_records_retained",
    "confidence_guarantee",
    "realized_profit_claimed",
    "production_promotion_authority",
    "source_manifest_sha256",
    "source_completeness_scope",
    "global_completeness_guarantee"
  ],
  "title": "Aladdin MEV Historical Economic Scoreboard v1",
  "type": "object"
}
