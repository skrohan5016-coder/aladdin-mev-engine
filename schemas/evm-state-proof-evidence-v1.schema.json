{
  "$id": "https://schemas.aladdin-mev.dev/evm-state-proof-evidence-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_exists": {
      "type": "boolean"
    },
    "account_terminal": {
      "enum": [
        "found-leaf",
        "found-branch-value",
        "absent-empty-trie",
        "absent-branch-child",
        "absent-branch-value",
        "absent-path-divergence",
        "absent-leaf-remainder"
      ]
    },
    "account_used_node_hashes": {
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "address": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "anchor_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "balance": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "block_hash": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "block_number": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ]
    },
    "code_hash": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "finality": {
      "enum": [
        "confirmed",
        "finalized"
      ]
    },
    "nonce": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "proof_observation_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proof_observed_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "proof_source_sequence": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-evm-state-proof-evidence/v1"
    },
    "source_id": {
      "enum": [
        "ethereum-json-rpc",
        "base-json-rpc"
      ]
    },
    "state_root": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "storage_root": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "storage_values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "included": {
            "type": "boolean"
          },
          "key": {
            "maxLength": 66,
            "minLength": 66,
            "pattern": "^0x[0-9a-f]{64}$",
            "type": "string"
          },
          "terminal": {
            "enum": [
              "found-leaf",
              "found-branch-value",
              "absent-empty-trie",
              "absent-branch-child",
              "absent-branch-value",
              "absent-path-divergence",
              "absent-leaf-remainder"
            ]
          },
          "used_node_hashes": {
            "items": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 256,
            "type": "array",
            "uniqueItems": true
          },
          "value": {
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value",
          "included",
          "terminal",
          "used_node_hashes"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "chain",
    "source_id",
    "finality",
    "block_number",
    "block_hash",
    "state_root",
    "address",
    "account_exists",
    "nonce",
    "balance",
    "storage_root",
    "code_hash",
    "account_terminal",
    "account_used_node_hashes",
    "storage_values",
    "anchor_sha256",
    "proof_observation_sha256",
    "proof_source_sequence",
    "proof_observed_at_unix_ms"
  ],
  "title": "Aladdin MEV EVM State Proof Evidence v1",
  "type": "object"
}
