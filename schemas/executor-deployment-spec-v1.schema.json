{
  "$id": "https://schemas.aladdin.invalid/mev/executor-deployment-spec-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "address": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ]
    },
    "deployment_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "deployment_semantics": {
      "const": "authenticated-recorded-direct-runtime"
    },
    "deployment_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "interface": {
      "$ref": "executor-interface-v1.schema.json"
    },
    "interface_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_code_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-executor-deployment-spec/v1"
    },
    "valid_from_block": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "valid_until_block": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "deployment_id",
    "chain",
    "address",
    "runtime_code_hash",
    "interface",
    "interface_sha256",
    "valid_from_block",
    "valid_until_block",
    "deployment_source_sha256",
    "deployment_semantics"
  ],
  "title": "Aladdin MEV Executor Deployment Spec v1",
  "type": "object"
}
