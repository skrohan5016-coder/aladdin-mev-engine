{
  "$id": "https://schemas.aladdin-mev.dev/evm-log-entry-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "address": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "data": {
      "maxLength": 524290,
      "pattern": "^0x(?:[0-9a-f]{2})*$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-evm-log-entry/v1"
    },
    "topics": {
      "items": {
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "address",
    "topics",
    "data"
  ],
  "type": "object"
}
