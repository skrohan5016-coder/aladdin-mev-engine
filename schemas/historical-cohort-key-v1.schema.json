{
  "$id": "https://schemas.aladdin-mev.dev/historical-cohort-key-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_asset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ],
      "type": "string"
    },
    "execution_constraint_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "executor_deployment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "executor_interface_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "funding_kind": {
      "enum": [
        "own-inventory",
        "flash-loan"
      ],
      "type": "string"
    },
    "funding_provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "funding_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "historical_valuation_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "inclusion_finality": {
      "enum": [
        "confirmed",
        "finalized"
      ],
      "type": "string"
    },
    "pool_model_registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profit_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "relay_endpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "relay_response_source_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rollup_fee_source_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "route_simulation_engine_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-historical-cohort-key/v1"
    },
    "sender_address": {
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "settlement_event_registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "settlement_event_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signature_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "simulation_environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "strategy": {
      "const": "atomic-dex-arbitrage"
    },
    "transaction_simulation_engine_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "base_asset_sha256",
    "chain",
    "execution_constraint_policy_sha256",
    "executor_deployment_sha256",
    "executor_interface_sha256",
    "funding_kind",
    "funding_provider_id",
    "funding_source_sha256",
    "inclusion_finality",
    "pool_model_registry_sha256",
    "profit_policy_sha256",
    "relay_endpoint_sha256",
    "relay_response_source_set_sha256",
    "rollup_fee_source_identity_sha256",
    "route_simulation_engine_set_sha256",
    "schema",
    "sender_address",
    "settlement_event_registry_sha256",
    "settlement_event_spec_sha256",
    "signature_source_sha256",
    "simulation_environment_sha256",
    "strategy",
    "transaction_simulation_engine_set_sha256",
    "historical_valuation_policy_sha256"
  ],
  "title": "Aladdin MEV Historical Cohort Key v1",
  "type": "object"
}
