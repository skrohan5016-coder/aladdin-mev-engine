{
  "$id": "https://schemas.aladdin-mev.dev/historical-outcome-corpus-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cohort_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "corpus_authority": {
      "const": "offline-exact-declared-source-window-inclusion-conditioned-history-only"
    },
    "created_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "global_completeness_guarantee": {
      "const": false
    },
    "realized_profit_authority": {
      "const": "none"
    },
    "record_count": {
      "maxLength": 3,
      "pattern": "^(?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
      "type": "string"
    },
    "record_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "records": {
      "items": {
        "$ref": "historical-execution-record-v1.schema.json"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "aladdin-mev-historical-outcome-corpus/v1"
    },
    "selection_bias_control": {
      "const": "all-declared-source-references-consumed-with-explicit-scoreability"
    },
    "source_manifest": {
      "$ref": "historical-corpus-source-manifest-v1.schema.json"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "source_manifest",
    "source_manifest_sha256",
    "records",
    "record_sha256",
    "cohort_sha256",
    "record_count",
    "created_at_unix_ms",
    "corpus_authority",
    "selection_bias_control",
    "global_completeness_guarantee",
    "realized_profit_authority"
  ],
  "title": "Aladdin MEV Historical Outcome Corpus v1",
  "type": "object"
}
