{
  "$id": "https://schemas.aladdin.invalid/mev/constant-product-pool-spec-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ]
    },
    "implementation": {
      "$ref": "constant-product-implementation-v1.schema.json"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pool_address": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-constant-product-pool-spec/v1"
    },
    "spec_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "token0": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "token1": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "spec_id",
    "chain",
    "pool_address",
    "token0",
    "token1",
    "implementation",
    "implementation_sha256"
  ],
  "title": "Aladdin MEV Constant Product Pool Spec v1",
  "type": "object"
}
