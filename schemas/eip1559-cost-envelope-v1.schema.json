{
  "$id": "https://schemas.aladdin.invalid/mev/eip1559-cost-envelope-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ]
    },
    "direct_inclusion_payment_upper_bound": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "direct_payment_semantics": {
      "const": "separate-conditional-payment-not-priority-fee"
    },
    "execution_gas_cost_upper_bound": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "gas_units_upper_bound": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "l1_data_fee_upper_bound": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "max_fee_per_gas": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "max_priority_fee_per_gas": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "native_asset": {
      "$ref": "asset-id-v1.schema.json"
    },
    "observed_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "priority_fee_semantics": {
      "const": "included-inside-max-fee-per-gas-not-added-again"
    },
    "schema": {
      "const": "aladdin-mev-eip1559-cost-envelope/v1"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "total_native_upper_bound": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "valid_until_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "chain",
    "native_asset",
    "gas_units_upper_bound",
    "max_fee_per_gas",
    "max_priority_fee_per_gas",
    "execution_gas_cost_upper_bound",
    "l1_data_fee_upper_bound",
    "direct_inclusion_payment_upper_bound",
    "total_native_upper_bound",
    "priority_fee_semantics",
    "direct_payment_semantics",
    "observed_at_unix_ms",
    "valid_until_unix_ms",
    "source_sha256"
  ],
  "title": "Aladdin MEV EIP-1559 Cost Envelope v1",
  "type": "object"
}
