{
  "$id": "https://schemas.aladdin.invalid/mev/conservative-valuation-rate-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_in": {
      "$ref": "asset-id-v1.schema.json"
    },
    "asset_out": {
      "$ref": "asset-id-v1.schema.json"
    },
    "denominator": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "numerator": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "observed_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "rate_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "rounding": {
      "const": "ceiling"
    },
    "schema": {
      "const": "aladdin-mev-conservative-valuation-rate/v1"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "valid_until_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "rate_id",
    "asset_in",
    "asset_out",
    "numerator",
    "denominator",
    "rounding",
    "observed_at_unix_ms",
    "valid_until_unix_ms",
    "source_sha256"
  ],
  "title": "Aladdin MEV Conservative Valuation Rate v1",
  "type": "object"
}
