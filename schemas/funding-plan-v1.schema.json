{
  "$id": "https://schemas.aladdin.invalid/mev/funding-plan-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "$ref": "asset-id-v1.schema.json"
    },
    "fee": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "own-inventory",
        "flash-loan"
      ]
    },
    "observed_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "principal": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-funding-plan/v1"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "valid_until_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "kind",
    "asset",
    "principal",
    "fee",
    "provider_id",
    "observed_at_unix_ms",
    "valid_until_unix_ms",
    "source_sha256"
  ],
  "title": "Aladdin MEV Funding Plan v1",
  "type": "object"
}
