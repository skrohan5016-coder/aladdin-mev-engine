{
  "$id": "https://schemas.aladdin.invalid/mev/unsigned-eip1559-transaction-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_list": {
      "items": {},
      "maxItems": 0,
      "minItems": 0,
      "type": "array"
    },
    "call": {
      "$ref": "governed-executor-call-v1.schema.json"
    },
    "call_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "chain": {
      "enum": [
        "ethereum",
        "base"
      ]
    },
    "chain_id": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "created_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "data": {
      "maxLength": 131074,
      "pattern": "^0x(?:[0-9a-f]{2})*$",
      "type": "string"
    },
    "execution_eligible": {
      "const": false
    },
    "gas_limit": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "inputs_valid_until_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "intrinsic_gas": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "max_fee_per_gas": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "max_priority_fee_per_gas": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "maximum_upfront_native": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "nonce": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "nonce_offset": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-unsigned-eip1559-transaction/v1"
    },
    "sender": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "sender_state": {
      "$ref": "sender-state-evidence-v1.schema.json"
    },
    "sender_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signature": {
      "type": "null"
    },
    "signing_eligible": {
      "const": false
    },
    "signing_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "signing_payload": {
      "maxLength": 131074,
      "pattern": "^0x(?:[0-9a-f]{2})*$",
      "type": "string"
    },
    "submission_eligible": {
      "const": false
    },
    "to": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "transaction_authority": {
      "const": "unsigned-deterministic-preimage-only"
    },
    "transaction_id": {
      "pattern": "^unsigned-tx-[0-9a-f]{64}$",
      "type": "string"
    },
    "transaction_type": {
      "const": "0x02"
    },
    "value": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "transaction_id",
    "call",
    "call_sha256",
    "sender_state",
    "sender_state_sha256",
    "transaction_type",
    "chain",
    "chain_id",
    "sender",
    "nonce",
    "nonce_offset",
    "max_priority_fee_per_gas",
    "max_fee_per_gas",
    "gas_limit",
    "intrinsic_gas",
    "to",
    "value",
    "data",
    "access_list",
    "maximum_upfront_native",
    "signing_payload",
    "signing_hash",
    "signature",
    "created_at_unix_ms",
    "inputs_valid_until_unix_ms",
    "transaction_authority",
    "signing_eligible",
    "submission_eligible",
    "execution_eligible"
  ],
  "title": "Aladdin MEV Unsigned EIP-1559 Transaction v1",
  "type": "object"
}
