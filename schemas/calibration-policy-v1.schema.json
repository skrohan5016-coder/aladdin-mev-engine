{
  "$id": "https://schemas.aladdin-mev.dev/calibration-policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bucket_semantics": {
      "const": "lower-inclusive-upper-exclusive-plus-open-ended-final-bucket"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "predicted_return_upper_bounds_bps": {
      "items": {
        "maxLength": 78,
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 15,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "aladdin-mev-calibration-policy/v1"
    }
  },
  "required": [
    "schema",
    "policy_id",
    "predicted_return_upper_bounds_bps",
    "bucket_semantics"
  ],
  "title": "Aladdin MEV Calibration Policy v1",
  "type": "object"
}
