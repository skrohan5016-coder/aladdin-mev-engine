{
  "$id": "https://schemas.aladdin-mev.dev/historical-calibration-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bucket_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "buckets": {
      "items": {
        "$ref": "calibration-bucket-v1.schema.json"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "calibration_scope": {
      "const": "exact-cohort-inclusion-conditioned-scoreable-subset"
    },
    "confidence_guarantee": {
      "const": false
    },
    "created_at_unix_ms": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "global_completeness_guarantee": {
      "const": false
    },
    "nonempty_bucket_count": {
      "maxLength": 2,
      "pattern": "^(?:0|[1-9]|1[0-6])$",
      "type": "string"
    },
    "policy": {
      "$ref": "calibration-policy-v1.schema.json"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "production_promotion_authority": {
      "const": false
    },
    "report_id": {
      "pattern": "^historical-calibration-[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-historical-calibration-report/v1"
    },
    "scoreboard_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_completeness_scope": {
      "const": "exact-declared-source-window-reference-set-only"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "unscoreable_records_retained_in_bucket_attempt_counts": {
      "const": true
    },
    "worst_nonempty_bucket_mean_absolute_error_ceiling": {
      "maxLength": 156,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "report_id",
    "scoreboard_sha256",
    "policy",
    "policy_sha256",
    "buckets",
    "bucket_sha256",
    "nonempty_bucket_count",
    "worst_nonempty_bucket_mean_absolute_error_ceiling",
    "created_at_unix_ms",
    "calibration_scope",
    "unscoreable_records_retained_in_bucket_attempt_counts",
    "confidence_guarantee",
    "production_promotion_authority",
    "source_manifest_sha256",
    "source_completeness_scope",
    "global_completeness_guarantee"
  ],
  "title": "Aladdin MEV Historical Calibration Report v1",
  "type": "object"
}
