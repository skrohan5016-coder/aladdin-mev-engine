{
  "$id": "https://schemas.aladdin-mev.dev/evm-state-proof-payload-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_proof": {
      "items": {
        "maxLength": 131074,
        "minLength": 4,
        "pattern": "^0x(?:[0-9a-f]{2})+$",
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "address": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "balance": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "block_hash": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "block_number": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "code_hash": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "nonce": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "schema": {
      "const": "aladdin-mev-evm-state-proof-payload/v1"
    },
    "state_root": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "storage_proofs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 66,
            "minLength": 66,
            "pattern": "^0x[0-9a-f]{64}$",
            "type": "string"
          },
          "proof": {
            "items": {
              "maxLength": 131074,
              "minLength": 4,
              "pattern": "^0x(?:[0-9a-f]{2})+$",
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "value": {
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value",
          "proof"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "storage_root": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "block_number",
    "block_hash",
    "state_root",
    "address",
    "nonce",
    "balance",
    "storage_root",
    "code_hash",
    "account_proof",
    "storage_proofs"
  ],
  "title": "Aladdin MEV EVM State Proof Payload v1",
  "type": "object"
}
